# Token bota iz Discord Developer Portala (Bot -> Reset Token)
DISCORD_TOKEN=

# (opcionalno) ID servera - slash komande se registriraju odmah samo na tom serveru.
# Ako je prazno, komande se registriraju globalno.
GUILD_ID=

# (opcionalno) Port za mali HTTP "keep-alive" server (za hostinge tipa Render / uptime monitore)
PORT=

# (opcionalno) Folder gdje se sprema baza (data/db.json)
DATA_DIR=./data
