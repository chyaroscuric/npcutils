# Token bota iz Discord Developer Portala (Bot -> Reset Token)
DISCORD_TOKEN=

# (opcionalno) ID servera - slash komande se registriraju odmah samo na tom serveru.
# Ako je prazno, komande se registriraju globalno.
GUILD_ID=

# Port za web dashboard (i /health endpoint). Bez PORT-a dashboard ne radi.
PORT=3000

# Dashboard: Client Secret iz Developer Portala (OAuth2 -> Client Secret)
CLIENT_SECRET=
# Javna adresa dashboarda (bez / na kraju). U Developer Portalu -> OAuth2 -> Redirects dodaj: <DASHBOARD_URL>/callback
DASHBOARD_URL=http://localhost:3000

# (opcionalno) Folder gdje se sprema baza (data/db.json)
DATA_DIR=./data

# (opcionalno) Putanje do ffmpeg / yt-dlp ako ih želiš sam postaviti.
# Inače se koristi ffmpeg iz npm paketa, a yt-dlp se sam preuzme u data/bin.
FFMPEG_PATH=
YTDLP_PATH=
