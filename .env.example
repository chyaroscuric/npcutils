# BYOT manager: OAuth aplikacija koja služi samo za prijavu na panel.
# CLIENT_ID je Application ID, CLIENT_SECRET je OAuth2 Client Secret.
CLIENT_ID=
CLIENT_SECRET=

# (opcionalno) Token bota iz .env koji se automatski uveze kao prvi bot.
# Ako koristiš samo web panel, ostavi prazno.
DISCORD_TOKEN=

# (opcionalno) Discord ID vlasnika uvezenog bota. Potreban za automatski uvoz.
BOT_OWNER_ID=

# (opcionalno) Ključ za enkripciju bot tokena. Ako je prazno, generira se
# data/manager/key na prvom pokretanju.
TOKEN_ENCRYPTION_KEY=

# (opcionalno) Početni interni port za bot procese (default 4100).
BOT_PORT_START=4100

# (opcionalno) ID servera - slash komande se registriraju odmah samo na tom serveru.
# Ako je prazno, komande se registriraju globalno.
GUILD_ID=

# Port za BYOT panel (i /health endpoint).
PORT=3000

# Javna adresa panela (bez / na kraju). U Developer Portalu -> OAuth2 -> Redirects dodaj: <DASHBOARD_URL>/callback
DASHBOARD_URL=http://localhost:3000

# (opcionalno) Folder gdje se spremaju manager baza i podaci svih botova.
DATA_DIR=./data

# (opcionalno) Putanje do ffmpeg / yt-dlp ako ih želiš sam postaviti.
# Inače se koristi ffmpeg iz npm paketa, a yt-dlp se sam preuzme u data/bin.
FFMPEG_PATH=
YTDLP_PATH=

# (opcionalno) Koliko često provjeravati YouTube/TikTok/Twitch za nove videe i streamove.
# Minimalno 2, zadano 5 minuta.
SOCIAL_POLL_MINUTES=5

# (opcionalno) Vremenska zona za rođendane. Zadano Europe/Zagreb.
BOT_TIMEZONE=Europe/Zagreb
